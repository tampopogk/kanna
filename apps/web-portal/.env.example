# Local development only: copy to an untracked `.env.local` and point it at the
# Firebase emulators. Cloud deploys do not read this file — `./kd cloud deploy`
# resolves the portal's public configuration from the committed per-project
# `.env.kanna-build` / `.env.kanna-staging` beside it, overridden by any
# `KANNA_WEB_PORTAL_*` variable the deployer exports. See README.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_KANNA_CLOUD_PRICE=$5/month
