# Public account-portal browser configuration for the production Firebase
# project (kanna-build). `./kd cloud deploy production --portal` reads this file
# as a layer beneath its own environment, so an operator export still wins.
#
# These are NOT secrets. Vite compiles every value here into the portal bundle
# and Firebase Hosting serves it to every visitor; each one below was read back
# out of the live bundle at https://kanna-build-account.web.app. The Stripe
# SECRET key and STRIPE_WEBHOOK_SECRET live in the Functions secret store
# (`firebase functions:secrets:set`) and must never appear in a repository file.
#
# Vite does not load this file: it reads `.env.[mode]`, and the portal build
# runs in mode "production". `kd` is the only reader.
KANNA_WEB_PORTAL_FIREBASE_API_KEY=AIzaSyCi-PNR-oVOXjEKGJvDOF6wM-1J3Fd3U4k
KANNA_WEB_PORTAL_FIREBASE_APP_ID=1:402613185450:web:252b2c98d1ef13bed859d3
# Stripe live publishable key, account acct_1Swxz4RSDDrR2YPq
# (`docs/specs/accounts-and-billing.md`).
KANNA_WEB_PORTAL_STRIPE_PUBLISHABLE_KEY=pk_live_51Swxz4RSDDrR2YPqH6QaeXfvtxno2vfJfHwrsAz2Trbksrs5t2a4ciphoLJw3s1As1tyVJmWKy1AKThcHoRRd6Yn00aOBhp8Se

# KANNA_WEB_PORTAL_FIREBASE_AUTH_DOMAIN, _FIREBASE_FUNCTIONS_REGION and
# _CLOUD_PRICE are deliberately unset: the resolver's defaults
# (kanna-build.firebaseapp.com, us-central1, $5/month) are what the live bundle
# already carries.
