genrule(
    name = "kanna_desktop_lib_rs",
    srcs = [
        ":full_context_rust_support",
        "//:VERSION",
        "src/lib.rs",
    ],
    tools = ["//tools/bazel:normalize_tauri_context.py"],
    outs = ["src/lib_bazel.rs"],
    cmd = """
python3 - "$(location src/lib.rs)" "$(location :full_context_rust_support)" "$(location //:VERSION)" "$(location //tools/bazel:normalize_tauri_context.py)" "$@" <<'PY'
import json
import pathlib
import re
import sys

src = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
support_dir = pathlib.Path(sys.argv[2])
version = pathlib.Path(sys.argv[3]).read_text(encoding="utf-8").strip()
helper_path = pathlib.Path(sys.argv[4])
sys.path.insert(0, str(helper_path.parent))
from normalize_tauri_context import normalize_generated_context
support_dir_literal = json.dumps(f"../{support_dir.name}")
context = (support_dir / "full_context_rust.rs").read_text(encoding="utf-8")
context = re.sub(
    r'::\\s*std\\s*::\\s*env\\s*!\\s*\\(\\s*"OUT_DIR"\\s*\\)',
    support_dir_literal,
    context,
)
context = normalize_generated_context(context)
needle = "tauri::generate_context!()"
if needle not in src:
    raise SystemExit(f"missing {needle} in src/lib.rs")
src = src.replace(needle, context, 1)
version_const = 'pub(crate) const KANNA_VERSION: &str = env!("KANNA_VERSION");'
if version_const not in src:
    raise SystemExit(f"missing {version_const} in src/lib.rs")
src = src.replace(version_const, f'pub(crate) const KANNA_VERSION: &str = {json.dumps(version)};', 1)
pathlib.Path(sys.argv[5]).write_text(
    "// Bazel release builds consume the generated Tauri context directly.\\n" + src,
    encoding="utf-8",
)
PY
""",
)

# The version the app itself reports -- the About panel's short version and
# the `version` kd's server.toml gets from `KANNA_VERSION` -- is substituted
# into this copy of lib.rs, because the Bazel libraries take the generated
# context rather than running build.rs. It must read the same file the
# staging bundle's `version_file` and Tauri config do, or the bundle says
# `X.Y.Z-staging.N` while everything a human or an agent reads says `X.Y.Z`.
genrule(
    name = "kanna_desktop_staging_lib_rs",
    srcs = [
        ":full_staging_context_rust_support",
        "//:staging_version_file",
        "src/lib.rs",
    ],
    tools = ["//tools/bazel:normalize_tauri_context.py"],
    outs = ["src/lib_staging_bazel.rs"],
    cmd = """
python3 - "$(location src/lib.rs)" "$(location :full_staging_context_rust_support)" "$(location //:staging_version_file)" "$(location //tools/bazel:normalize_tauri_context.py)" "$@" <<'PY'
import json
import pathlib
import re
import sys

src = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
support_dir = pathlib.Path(sys.argv[2])
version = pathlib.Path(sys.argv[3]).read_text(encoding="utf-8").strip()
helper_path = pathlib.Path(sys.argv[4])
sys.path.insert(0, str(helper_path.parent))
from normalize_tauri_context import normalize_generated_context
support_dir_literal = json.dumps(f"../{support_dir.name}")
context = (support_dir / "full_context_rust.rs").read_text(encoding="utf-8")
context = re.sub(
    r'::\\s*std\\s*::\\s*env\\s*!\\s*\\(\\s*"OUT_DIR"\\s*\\)',
    support_dir_literal,
    context,
)
context = normalize_generated_context(context)
needle = "tauri::generate_context!()"
if needle not in src:
    raise SystemExit(f"missing {needle} in src/lib.rs")
src = src.replace(needle, context, 1)
version_const = 'pub(crate) const KANNA_VERSION: &str = env!("KANNA_VERSION");'
if version_const not in src:
    raise SystemExit(f"missing {version_const} in src/lib.rs")
src = src.replace(version_const, f'pub(crate) const KANNA_VERSION: &str = {json.dumps(version)};', 1)
pathlib.Path(sys.argv[5]).write_text(
    "// Bazel staging release builds consume the generated Tauri context directly.\\n" + src,
    encoding="utf-8",
)
PY
""",
)

cargo_build_script(
    name = "desktop_build_script",
    srcs = [
        "build.rs",
        "build_support/sidecars.rs",
    ],
    crate_root = "build.rs",
    edition = "2021",
    rundir = "apps/desktop/src-tauri",
    version = "0.0.32",
    deps = all_crate_deps(
        build = True,
        package_name = "apps/desktop/src-tauri",
    ),
    link_deps = [
        "@desktop_crates//:tauri",
        "@desktop_crates//:tauri-plugin-dialog",
        "@desktop_crates//:tauri-plugin-opener",
        "@desktop_crates//:tauri-plugin-process",
        "@desktop_crates//:tauri-plugin-shell",
        "@desktop_crates//:tauri-plugin-updater",
        "@desktop_crates//:tauri-plugin-webdriver",
    ],
    proc_macro_deps = all_crate_deps(
        build_proc_macro = True,
        package_name = "apps/desktop/src-tauri",
    ),
    data = [
        "//:VERSION",
        ":cargo_srcs",
        ":tauri_build_data",
    ],
    compile_data = [
        "//:VERSION",
        ":cargo_srcs",
        ":tauri_build_data",
    ],
    build_script_env = {
        "DEP_TAURI_DEV": "false",
        "KANNA_BUILD_BRANCH": "",
        "KANNA_BUILD_COMMIT": "",
        "KANNA_BUILD_TASK_ID": "",
        "KANNA_BUILD_WORKTREE": "",
        # Only the non-codegen `kanna_desktop_lib` reaches build.rs, and no
        # bundle uses it -- every shipped binary takes its KANNA_VERSION from
        # one of the lib.rs codegen genrules above. So this is the bare
        # release version, and a flavor is never selected here.
        "KANNA_VERSION_FILE": "$(location //:VERSION)",
        "TAURI_CONFIG": "{\"bundle\":{\"externalBin\":[],\"resources\":[]}}",
    },
)

