package(default_visibility = ["//visibility:public"])

load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@kanna_npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(
    name = "node_modules",
)

filegroup(
    name = "srcs",
    srcs = [
        "package.json",
        "tsconfig.json",
    ] + glob(
        ["src/**"],
        exclude = ["src/**/*.test.ts"],
    ),
)

copy_to_bin(
    name = "srcs_in_bin",
    srcs = [":srcs"],
)

js_library(
    name = "pkg",
    srcs = [":srcs"],
    deps = [
        "//:.aspect_rules_js/node_modules/@blocknote+core@0.55.0_819479880",
        "//:.aspect_rules_js/node_modules/@blocknote+mantine@0.55.0_992202580",
        "//:.aspect_rules_js/node_modules/@blocknote+react@0.55.0_1258744920",
        "//:.aspect_rules_js/node_modules/@mantine+core@9.6.2_2091157797",
        "//:.aspect_rules_js/node_modules/@mantine+hooks@9.6.2_1113999364",
        "//:.aspect_rules_js/node_modules/@tiptap+pm@3.31.3",
        "//:.aspect_rules_js/node_modules/react-dom@19.2.3_react@19.2.3",
        "//:.aspect_rules_js/node_modules/react@19.2.3",
        "//:.aspect_rules_js/node_modules/y-prosemirror@1.3.7_1835746341",
        "//:.aspect_rules_js/node_modules/y-protocols@1.0.6_yjs@13.6.33",
        "//:.aspect_rules_js/node_modules/yjs@13.6.33",
    ],
)
