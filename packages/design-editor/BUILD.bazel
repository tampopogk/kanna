package(default_visibility = ["//visibility:public"])

load("@kanna_npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(
    name = "node_modules",
)

filegroup(
    name = "srcs",
    srcs = [
        "package.json",
        "tsconfig.json",
    ] + glob(
        ["src/**"],
        exclude = ["src/**/*.test.ts"],
    ),
)
