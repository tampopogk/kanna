[
  {
    "name": "move docks a pane on a side of another, taking half its space",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "to": "b", "side": "bottom" } },
        "expect": { "window": "win-1", "tab": "tab-1", "layout": { "split": "column", "children": [ { "pane": "b", "size": "1/2" }, { "pane": "a", "size": "1/2" } ] } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "to": "b", "side": "left" } },
        "expect": { "layout": { "split": "row", "children": [ { "pane": "a", "size": "1/2" }, { "pane": "b", "size": "1/2" } ] } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a" } ] } }
    ]
  },
  {
    "name": "move swaps two panes by default",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right", "size": "1/3" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "to": "b" } },
        "expect": { "layout": { "split": "row", "children": [ { "pane": "b", "size": "2/3" }, { "pane": "a", "size": "1/3" } ] } } }
    ]
  },
  {
    "name": "move to a new tab, an existing tab, or a new window; empty tabs close",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "move", "args": { "pane": "b", "tab": "new" } }, "expect": { "window": "win-1", "tab": "tab-2", "layout": { "pane": "b" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "tab": "tab-2" } },
        "expect": { "tab": "tab-2", "layout": { "split": "row", "children": [ { "pane": "b", "size": "1/2" }, { "pane": "a", "size": "1/2" } ] } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "tabs": [ { "id": "tab-2", "title": "Tab 2", "active": true } ] } ] } },
      { "send": { "cmd": "move", "args": { "pane": "b", "window": "new" } }, "expect": { "window": "win-2", "layout": { "pane": "b" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "key": false }, { "id": "win-2", "key": true, "focused": "b" } ] } }
    ]
  },
  {
    "name": "move errors",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "move", "args": { "pane": "a" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "to": "zzz" } }, "expect": { "ok": false, "error": { "code": "not_found" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "tab": "tab-9" } }, "expect": { "ok": false, "error": { "code": "not_found" } } }
    ]
  },
  {
    "name": "move-tab reorders tabs and moves them between windows",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "tab": true } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c", "tab": true } } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-3", "index": 0 } }, "expect": { "window": "win-1", "tabs": [ "tab-3", "tab-1", "tab-2" ] } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-3", "index": 2 } }, "expect": { "tabs": [ "tab-1", "tab-3", "tab-2" ] } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-1", "window": "new" } }, "expect": { "window": "win-2", "tabs": [ "tab-1" ] } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "tabs": [ { "id": "tab-3" }, { "id": "tab-2" } ] }, { "id": "win-2", "key": true, "focused": "a" } ] } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-1", "window": "win-1", "index": 0 } }, "expect": { "window": "win-1", "tabs": [ "tab-1", "tab-3", "tab-2" ] } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "key": true } ] } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-1", "index": -1 } }, "expect": { "ok": false, "error": { "code": "bad_request" } } }
    ]
  },
  {
    "name": "resize sets a pane's share; its siblings keep their proportions",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "resize", "args": { "pane": "a", "size": "1/3" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c", "split": "right" } } },
      { "send": { "cmd": "resize", "args": { "pane": "a", "size": "3/4" } },
        "expect": { "layout": { "split": "row", "children": [ { "pane": "a", "size": "3/4" }, { "pane": "b", "size": "1/8" }, { "pane": "c", "size": "1/8" } ] } } },
      { "send": { "cmd": "resize", "args": { "pane": "a", "size": "1" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } }
    ]
  },
  {
    "name": "a divider dragged in a client is resize with tab, path and index: the panes either side share what they had, the first getting share",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c", "split": "down" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "d", "split": "down" } } },
      { "send": { "cmd": "resize", "args": { "tab": "tab-1", "path": [], "index": 0, "share": 0.25 } },
        "expect": { "ok": true, "tab": "tab-1", "layout": { "split": "row", "children": [ { "pane": "a", "size": "1/4" }, { "split": "column", "size": "3/4" } ] } } },
      { "send": { "cmd": "resize", "args": { "tab": "tab-1", "path": [1], "index": 1, "share": 0.375 } },
        "expect": { "ok": true, "tab": "tab-1" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "tabs": [ { "layout": { "split": "row", "children": [
        { "pane": "a", "size": "1/4" },
        { "split": "column", "size": "3/4", "children": [ { "pane": "b", "size": "1/2" }, { "pane": "c", "size": "3/8" }, { "pane": "d", "size": "1/8" } ] }
      ] } } ] } ] } },
      { "send": { "cmd": "resize", "args": { "tab": "tab-1", "path": [1], "index": 1, "share": 0.5 } }, "expect": { "ok": false, "error": { "code": "bad_request", "message": "the share must leave both panes some space" } } },
      { "send": { "cmd": "resize", "args": { "tab": "tab-1", "path": [1], "index": 2, "share": 0.1 } }, "expect": { "ok": false, "error": { "code": "bad_request", "message": "no divider at that index" } } },
      { "send": { "cmd": "resize", "args": { "tab": "tab-1", "path": [0], "index": 0, "share": 0.1 } }, "expect": { "ok": false, "error": { "code": "bad_request", "message": "no split at that path" } } },
      { "send": { "cmd": "resize", "args": { "tab": "tab-9", "path": [], "index": 0, "share": 0.1 } }, "expect": { "ok": false, "error": { "code": "not_found" } } }
    ]
  }
]
