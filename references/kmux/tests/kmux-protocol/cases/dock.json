[
  {
    "name": "open with dock makes the window's docked pane, outside its tabs, 2/5 wide on the left",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } },
        "expect": { "ok": true, "pane": { "id": "term-1", "name": "agent" }, "window": "win-1", "tab": null, "dock": "left" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "key": true, "focused": "agent", "zoomed": null,
        "dock": { "pane": "agent", "edge": "left", "width": "2/5" }, "tabs": [] } ] } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } },
        "expect": { "ok": true, "window": "win-1", "tab": "tab-1", "pane": { "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "md", "path": "docs/spec.md", "name": "doc", "split": "right" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "doc", "dock": { "pane": "agent", "edge": "left", "width": "2/5" },
        "tabs": [ { "id": "tab-1", "title": "Tab 1", "layout": { "split": "row", "children": [ { "pane": "a", "size": "1/2" }, { "pane": "doc", "size": "1/2" } ] } } ] } ] } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "right", "dock": "right", "window": "new" } },
        "expect": { "window": "win-2", "tab": null, "dock": "right" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "key": false }, { "id": "win-2", "key": true, "dock": { "pane": "right", "edge": "right" } } ] } }
    ]
  },
  {
    "name": "dock refuses a split, size or tab, and edges other than left and right",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "dock": "top" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "dock": "left", "split": "right" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "dock": "left", "size": "1/3" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "dock": "left", "tab": true } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "dock": "middle" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "dock": null, "tabs": [ { "layout": { "pane": "a" } } ] } ], "panes": [ { "name": "a" } ] } }
    ]
  },
  {
    "name": "switching tabs leaves the docked pane; focus goes to the shown tab and back",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "tab": true } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "tabs": [ { "active": false }, { "active": true } ] } ] } },
      { "send": { "cmd": "focus", "args": { "tab": "tab-1" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "dock": { "pane": "agent" }, "tabs": [ { "active": true }, { "active": false } ] } ] } },
      { "send": { "cmd": "focus", "args": { "pane": "agent" } }, "expect": { "window": "win-1" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "tabs": [ { "active": true }, { "active": false } ] } ] } },
      { "send": { "cmd": "focus", "args": { "tab": "tab-2" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "dock": { "pane": "agent" }, "tabs": [ { "active": false }, { "active": true } ] } ] } }
    ]
  },
  {
    "name": "the docked pane closes only with its window; a window keeps it when its last tab closes",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "close", "args": { "pane": "agent" } },
        "expect": { "ok": false, "error": { "code": "docked", "message": "docked: it closes with its window" } } },
      { "send": { "cmd": "close", "args": { "pane": "a" } }, "expect": { "closed": [ "term-2" ] } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "focused": "agent", "dock": { "pane": "agent" }, "tabs": [] } ], "panes": [ { "name": "agent" } ] } },
      { "send": { "cmd": "restart", "args": { "pane": "agent" } }, "expect": { "ok": true, "pane": { "id": "term-3", "name": "agent", "state": "running" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "tab": true } } },
      { "send": { "cmd": "close", "args": { "tab": "tab-2" } }, "expect": { "closed": [ "term-4" ] } },
      { "send": { "cmd": "close", "args": { "window": "win-1" } }, "expect": { "closed": [ "term-3" ] } },
      { "send": { "cmd": "list" }, "expect": { "windows": [], "panes": [] } }
    ]
  },
  {
    "name": "moving a tab to another window leaves the docked pane where it is",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "tab": true } } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-2", "window": "new" } }, "expect": { "window": "win-2", "tabs": [ "tab-2" ] } },
      { "send": { "cmd": "move-tab", "args": { "tab": "tab-1", "window": "win-2" } }, "expect": { "window": "win-2", "tabs": [ "tab-2", "tab-1" ] } },
      { "send": { "cmd": "list" }, "expect": { "windows": [
        { "id": "win-1", "focused": "agent", "dock": { "pane": "agent", "edge": "left" }, "tabs": [] },
        { "id": "win-2", "key": true, "focused": "a", "dock": null, "tabs": [ { "id": "tab-2" }, { "id": "tab-1" } ] } ] } }
    ]
  },
  {
    "name": "move docks a pane, moves the docked pane to the other edge, and undocks it into a tab",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "split": "right" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "dock": "left" } },
        "expect": { "ok": true, "window": "win-1", "dock": { "pane": "agent", "edge": "left", "width": "2/5" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "dock": { "pane": "agent" }, "tabs": [ { "layout": { "pane": "a" } } ] } ] } },
      { "send": { "cmd": "resize", "args": { "pane": "agent", "size": "1/3" } }, "expect": { "ok": true, "dock": { "pane": "agent", "width": "1/3" } } },
      { "send": { "cmd": "resize", "args": { "pane": "agent", "size": "1" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "dock": "right" } },
        "expect": { "ok": true, "window": "win-1", "dock": { "pane": "agent", "edge": "right", "width": "1/3" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "tab": "new" } },
        "expect": { "ok": true, "window": "win-1", "tab": "tab-2", "layout": { "pane": "agent" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "dock": null, "tabs": [ { "id": "tab-1" }, { "id": "tab-2", "active": true } ] } ] } },
      { "send": { "cmd": "close", "args": { "pane": "agent" } }, "expect": { "closed": [ "term-2" ] } }
    ]
  },
  {
    "name": "docking where a pane is docked sends that one to a new tab, not shown",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "resize", "args": { "pane": "agent", "size": "1/4" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent2", "dock": "right" } }, "expect": { "tab": null, "dock": "right" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent2", "dock": { "pane": "agent2", "edge": "right", "width": "1/4" }, "tabs": [
        { "id": "tab-1", "active": true, "layout": { "pane": "a" } }, { "id": "tab-2", "title": "Tab 2", "active": false, "layout": { "pane": "agent" } } ] } ] } },
      { "send": { "cmd": "move", "args": { "pane": "a", "dock": "left" } }, "expect": { "dock": { "pane": "a", "edge": "left", "width": "1/4" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "dock": { "pane": "a" }, "tabs": [
        { "id": "tab-2", "active": true, "layout": { "pane": "agent" } }, { "id": "tab-3", "active": false, "layout": { "pane": "agent2" } } ] } ] } }
    ]
  },
  {
    "name": "moving the docked pane to another window or beside a pane undocks it; dropping on it swaps",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "window": "new" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "to": "b", "side": "right" } },
        "expect": { "window": "win-2", "layout": { "split": "row", "children": [ { "pane": "b", "size": "1/2" }, { "pane": "agent", "size": "1/2" } ] } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "dock": null }, { "id": "win-2", "dock": null } ] } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "dock": "left", "window": "win-1" } }, "expect": { "window": "win-1", "dock": { "pane": "agent" } } },
      { "send": { "cmd": "move", "args": { "pane": "b", "to": "agent", "side": "left" } },
        "expect": { "ok": false, "error": { "code": "docked" } } },
      { "send": { "cmd": "move", "args": { "pane": "b", "to": "agent" } }, "expect": { "ok": true, "window": "win-1", "dock": { "pane": "b" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [
        { "id": "win-1", "focused": "b", "dock": { "pane": "b", "edge": "left" }, "tabs": [ { "layout": { "pane": "a" } } ] },
        { "id": "win-2", "dock": null, "tabs": [ { "layout": { "pane": "agent" } } ] } ] } },
      { "send": { "cmd": "move", "args": { "pane": "b", "window": "win-2" } },
        "expect": { "window": "win-2", "layout": { "split": "row", "children": [ { "pane": "agent", "size": "1/2" }, { "pane": "b", "size": "1/2" } ] } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "dock": null, "focused": "a" }, { "id": "win-2" } ] } }
    ]
  },
  {
    "name": "a frozen docked pane doesn't move and nothing drops on it; it still resizes, is saved frozen and comes back frozen",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left", "frozen": true } }, "expect": { "ok": true, "window": "win-1", "dock": "left" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "dock": { "pane": "agent", "edge": "left", "width": "2/5", "frozen": true } } ] } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "window": "new" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "dock": "right" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "tab": "new" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "to": "b", "side": "right" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "window": "win-2" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "b", "to": "agent" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "a", "to": "agent", "side": "left" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "b", "dock": "left", "window": "win-1" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c", "dock": "right", "window": "win-1" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "frozen": true } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "dock": "left", "frozen": "yes" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [
        { "id": "win-1", "dock": { "pane": "agent", "edge": "left", "frozen": true }, "tabs": [ { "layout": { "pane": "a" } } ] },
        { "id": "win-2", "dock": null, "tabs": [ { "layout": { "pane": "b" } } ] } ], "panes": [ { "id": "term-1" }, { "id": "term-2" }, { "id": "term-3" } ] } },
      { "send": { "cmd": "resize", "args": { "pane": "agent", "size": "1/3" } }, "expect": { "ok": true, "dock": { "pane": "agent", "width": "1/3", "frozen": true } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "d", "dock": "left", "window": "win-2" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1" }, { "id": "win-2", "dock": { "pane": "d", "frozen": null } } ] } },
      { "send": { "cmd": "debug.saveState" }, "expect": { "ok": true, "state": { "windows": [
        { "id": "win-1", "dock": { "pane": "term-2", "edge": "left", "width": 0.3333333333333333, "frozen": true } },
        { "id": "win-2", "dock": { "pane": "term-4", "frozen": null } } ] } } },
      { "send": { "cmd": "debug.restoreState" }, "expect": { "ok": true, "windows": [ "win-1", "win-2" ] } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "dock": { "pane": "agent", "width": "1/3", "frozen": true } }, { "id": "win-2", "dock": { "pane": "d", "frozen": null } } ] } },
      { "send": { "cmd": "move", "args": { "pane": "agent", "dock": "right" } }, "expect": { "ok": false, "error": { "code": "frozen" } } },
      { "send": { "cmd": "move", "args": { "pane": "d", "dock": "right" } }, "expect": { "ok": true, "dock": { "pane": "d", "edge": "right" } } }
    ]
  },
  {
    "name": "zoom on a tab's pane leaves the docked pane; zoom on the docked pane fills the window; the zoom follows focus between them",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "zoom", "args": { "pane": "agent" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "zoomed": "agent", "dock": { "pane": "agent" } } ] } },
      { "send": { "cmd": "focus", "args": { "pane": "a" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "zoomed": "a" } ] } },
      { "send": { "cmd": "focus", "args": { "pane": "agent" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "zoomed": "agent" } ] } },
      { "send": { "cmd": "zoom", "args": { "pane": "agent" } }, "expect": { "zoomed": false } },
      { "send": { "cmd": "zoom", "args": { "pane": "b" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "zoomed": "b", "dock": { "pane": "agent" } } ] } }
    ]
  },
  {
    "name": "zoom on the docked pane of a window with no tabs fills the window, and stays on through a new tab pane and switching tabs",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "zoom", "args": { "pane": "agent" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "zoomed": "agent", "tabs": [] } ] } },
      { "send": { "cmd": "zoom", "args": { "pane": "agent" } }, "expect": { "zoomed": false } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "zoomed": null } ] } },
      { "send": { "cmd": "zoom", "args": { "pane": "agent" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "zoomed": "a" } ] } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "tab": true } } },
      { "send": { "cmd": "focus", "args": { "pane": "agent" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "agent", "zoomed": "agent" } ] } },
      { "send": { "cmd": "focus", "args": { "tab": "tab-1" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "zoomed": "a", "tabs": [ { "active": true }, { "active": false } ] } ] } }
    ]
  },
  {
    "name": "arrange arranges the shown tab; the docked pane is not part of a layout",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "dock": "left" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "column", "children": [ { "pane": "b", "size": "1/3" }, { "pane": "a" } ] } } },
        "expect": { "window": "win-1", "layout": { "split": "column", "children": [ { "pane": "b", "size": "1/3" }, { "pane": "a", "size": "2/3" } ] } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "dock": { "pane": "agent" }, "tabs": [ { "id": "tab-1" } ] } ] } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "row", "children": [ { "pane": "agent" }, { "pane": "a" }, { "pane": "b" } ] } } },
        "expect": { "ok": false, "error": { "code": "docked" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "dock": { "pane": "agent" }, "tabs": [ { "layout": { "split": "column", "children": [ { "pane": "b", "size": "1/3" }, { "pane": "a", "size": "2/3" } ] } } ] } ] } }
    ]
  },
  {
    "name": "the docked pane is saved with its window and comes back; a window with only a docked pane too",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a", "cmd": "make test" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "agent", "cmd": "claude", "dock": "right" } } },
      { "send": { "cmd": "resize", "args": { "pane": "agent", "size": "1/3" } } },
      { "send": { "cmd": "open", "args": { "type": "md", "path": "docs/spec.md", "name": "doc", "dock": "left", "window": "new" } } },
      { "send": { "cmd": "focus", "args": { "pane": "agent" } } },
      { "send": { "cmd": "zoom", "args": { "pane": "agent" } } },
      { "send": { "cmd": "debug.saveState" }, "expect": { "ok": true, "state": { "version": 2, "key": "win-1", "windows": [
        { "id": "win-1", "active": "tab-1", "focused": "term-2", "zoomed": "term-2", "dock": { "pane": "term-2", "edge": "right", "width": 0.3333333333333333 },
          "tabs": [ { "id": "tab-1", "lastFocus": "term-1", "layout": { "pane": "term-1" } } ] },
        { "id": "win-2", "active": null, "focused": "file-1", "zoomed": null, "dock": { "pane": "file-1", "edge": "left", "width": 0.4 }, "tabs": [] } ],
        "panes": [ { "id": "term-1" }, { "id": "term-2", "name": "agent", "type": "term", "cmd": "claude" }, { "id": "file-1", "name": "doc", "type": "md" } ] } } },
