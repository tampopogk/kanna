[
  {
    "name": "bad requests name the problem with an error code",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "nope" }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "nope" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } }, "expect": { "ok": false, "error": { "code": "name_taken" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "size": "3/2" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "size": "lots" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "split": "sideways" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "window": "win-9" } }, "expect": { "ok": false, "error": { "code": "not_found" } } },
      { "send": { "cmd": "open", "args": { "type": "ios" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "app": "Foo.app" } }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "close", "args": { "pane": "zzz" } }, "expect": { "ok": false, "error": { "code": "not_found" } } },
      { "send": { "cmd": "close" }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "focus" }, "expect": { "ok": false, "error": { "code": "bad_request" } } },
      { "send": { "cmd": "list" }, "expect": { "panes": [ { "name": "a" } ] } }
    ]
  }
]
