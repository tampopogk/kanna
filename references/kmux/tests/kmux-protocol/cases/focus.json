[
  {
    "name": "zoom is the window's mode: the focused pane is zoomed wherever focus goes, tabs included, until zoom turns it off",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c", "tab": true } } },
      { "send": { "cmd": "focus", "args": { "tab": "tab-1" } }, "expect": { "window": "win-1" } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "tabs": [ { "active": true }, { "active": false } ] } ] } },
      { "send": { "cmd": "zoom", "args": { "pane": "a" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "zoomed": "a" } ] } },
      { "send": { "cmd": "focus", "args": { "pane": "b" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "zoomed": "b" } ] } },
      { "send": { "cmd": "focus", "args": { "tab": "tab-2" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "c", "zoomed": "c", "tabs": [ { "active": false }, { "active": true } ] } ] } },
      { "send": { "cmd": "focus", "args": { "pane": "a" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "zoomed": "a", "tabs": [ { "active": true }, { "active": false } ] } ] } },
      { "send": { "cmd": "zoom", "args": { "pane": "b" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "zoomed": "b" } ] } },
      { "send": { "cmd": "zoom", "args": { "pane": "b" } }, "expect": { "zoomed": false } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "zoomed": null } ] } }
    ]
  },
  {
    "name": "zoom stays on as panes open, close and move: the pane focused after each is zoomed",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "zoom", "args": { "pane": "a" } }, "expect": { "zoomed": true } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "split": "right" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "b", "zoomed": "b" } ] } },
      { "send": { "cmd": "close", "args": { "pane": "b" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "a", "zoomed": "a" } ] } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c", "tab": true } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "focused": "c", "zoomed": "c" } ] } },
      { "send": { "cmd": "move", "args": { "pane": "c", "window": "new" } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "id": "win-1", "focused": "a", "zoomed": "a" }, { "id": "win-2", "zoomed": null } ] } }
    ]
  },
  {
    "name": "focusing a pane in another window makes that window key",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b", "window": "new" } } },
      { "send": { "cmd": "focus", "args": { "pane": "a" } }, "expect": { "window": "win-1" } },
      { "send": { "cmd": "focus", "args": { "window": "win-2" } }, "expect": { "window": "win-2" } },
      { "send": { "cmd": "focus", "args": { "window": "win-7" } }, "expect": { "ok": false, "error": { "code": "not_found" } } }
    ]
  }
]
