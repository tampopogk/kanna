[
  {
    "name": "arrange applies a layout tree; unsized panes share the rest",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "c" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "column", "children": [ { "pane": "c", "size": "1/2" }, { "pane": "a" }, { "pane": "b" } ] } } },
        "expect": { "window": "win-1", "layout": { "split": "column", "children": [ { "pane": "c", "size": "1/2" }, { "pane": "a", "size": "1/4" }, { "pane": "b", "size": "1/4" } ] } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "row", "children": [ { "pane": "a", "size": "1/3" }, { "pane": "b", "size": "1/3" } ] } } },
        "expect": { "layout": { "split": "row", "children": [ { "pane": "a", "size": "1/2" }, { "pane": "b", "size": "1/2" } ] } } },
      { "send": { "cmd": "list" }, "expect": { "windows": [ { "tabs": [ { "id": "tab-1", "active": true }, { "title": "unarranged", "active": false, "layout": { "pane": "c" } } ] } ] } }
    ]
  },
  {
    "name": "arrange rejects bad trees",
    "steps": [
      { "send": { "cmd": "open", "args": { "type": "term", "name": "a" } } },
      { "send": { "cmd": "open", "args": { "type": "term", "name": "b" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "row", "children": [ { "pane": "a", "size": "2/3" }, { "pane": "b", "size": "2/3" } ] } } },
        "expect": { "ok": false, "error": { "code": "layout_invalid" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "row", "children": [ { "pane": "a" }, { "pane": "a" } ] } } },
        "expect": { "ok": false, "error": { "code": "layout_invalid" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "diagonal", "children": [ { "pane": "a" } ] } } },
        "expect": { "ok": false, "error": { "code": "layout_invalid" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "row", "children": [ { "pane": "a", "size": "1" }, { "pane": "b" } ] } } },
        "expect": { "ok": false, "error": { "code": "layout_invalid" } } },
      { "send": { "cmd": "arrange", "args": { "layout": { "split": "row", "children": [ { "pane": "zzz" } ] } } },
        "expect": { "ok": false, "error": { "code": "not_found" } } }
    ]
  }
]
