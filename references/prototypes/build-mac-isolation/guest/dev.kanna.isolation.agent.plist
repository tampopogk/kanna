<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.kanna.isolation.agent</string>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>ProgramArguments</key>
    <array><string>/usr/bin/python3</string><string>/usr/local/kanna/agent.py</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardErrorPath</key><string>/tmp/dev.kanna.isolation.agent.log</string>
    <key>StandardOutPath</key><string>/tmp/dev.kanna.isolation.agent.log</string>
</dict>
</plist>
