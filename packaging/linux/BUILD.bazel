load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

load(":products.bzl", "linux_iteration", "linux_package_targets", "linux_product_targets")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pkg_config.rs",
    "resolve_sysroot.py",
    "runtime-policy.json",
    "runtime-policy.schema.json",
    "sysroot-amd64.lock.json",
    "sysroot-arm64.lock.json",
    "sysroot_overlay.c",
    "sysroot_repository.bzl",
])

rust_binary(
    name = "pkg_config",
    srcs = ["pkg_config.rs"],
    crate_root = "pkg_config.rs",
    edition = "2021",
)

rust_test(
    name = "pkg_config_test",
    srcs = ["pkg_config.rs"],
    crate_root = "pkg_config.rs",
    edition = "2021",
)

py_test(
    name = "resolve_sysroot_test",
    srcs = [
        "resolve_sysroot.py",
        "tests/test_resolve_sysroot.py",
    ],
    data = [
        ":sysroot_overlay_test_tool",
        "runtime-policy.json",
        "sysroot-amd64.lock.json",
        "sysroot-arm64.lock.json",
        "//:MODULE.bazel",
        "//tools/bazel:BUILD.bazel",
        "//tools/bazel:linux_cc_toolchain_config.bzl",
        "@ubuntu_noble_sysroot_amd64//:sysroot_overlay_report",
    ],
    main = "tests/test_resolve_sysroot.py",
    python_version = "PY3",
)

cc_binary(
    name = "sysroot_overlay_test_tool",
    srcs = ["sysroot_overlay.c"],
    testonly = True,
)

linux_product_targets()

py_binary(
    name = "artifact_tool",
    srcs = ["artifact_tool.py"],
    main = "artifact_tool.py",
)

linux_package_targets()

linux_iteration(name = "staging_iteration", build_setting_default = 1)

py_test(
    name = "artifact_tool_test",
    srcs = ["artifact_tool.py", "tests/test_artifact_tool.py"],
    main = "tests/test_artifact_tool.py",
)
