load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_zig//zig:toolchain.bzl", "zig_target_toolchain")

package(default_visibility = ["//visibility:public"])

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_zig//zig/platforms/abi:gnu",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_zig//zig/platforms/abi:gnu",
    ],
)

zig_target_toolchain(
    name = "linux_x86_64_zig_target",
    target = "x86_64-linux-gnu.2.39",
)

toolchain(
    name = "linux_x86_64_zig_target_toolchain",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_zig//zig/platforms/abi:gnu",
    ],
    toolchain = ":linux_x86_64_zig_target",
    toolchain_type = "@rules_zig//zig/target:toolchain_type",
)

zig_target_toolchain(
    name = "linux_arm64_zig_target",
    target = "aarch64-linux-gnu.2.39",
)

toolchain(
    name = "linux_arm64_zig_target_toolchain",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_zig//zig/platforms/abi:gnu",
    ],
    toolchain = ":linux_arm64_zig_target",
    toolchain_type = "@rules_zig//zig/target:toolchain_type",
)

cc_binary(
    name = "linux_toolchain_canary_x86_64",
    srcs = ["linux_toolchain_canary.c"],
    linkopts = ["-lgtk-3", "-lwebkit2gtk-4.1"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "linux_toolchain_canary_arm64",
    srcs = ["linux_toolchain_canary.c"],
    linkopts = ["-lgtk-3", "-lwebkit2gtk-4.1"],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

py_test(
    name = "build_macos_dmg_test",
    srcs = [
        "build_macos_dmg.py",
        "build_macos_dmg_test.py",
    ],
    main = "build_macos_dmg_test.py",
    python_version = "PY3",
)

py_test(
    name = "macos_deployment_target_test",
    srcs = [
        "macos_deployment_target.py",
        "macos_deployment_target_test.py",
    ],
    main = "macos_deployment_target_test.py",
    python_version = "PY3",
)

rust_proc_macro(
    name = "exec_proc_macro_probe",
    srcs = ["exec_proc_macro_probe.rs"],
    edition = "2021",
)

# `tools` builds the probe in the exec configuration (opt), like every proc
# macro rustc loads during a build.
genrule(
    name = "exec_proc_macro_probe_dylib",
    outs = ["exec_proc_macro_probe.dylib"],
    cmd = "cp $(execpath :exec_proc_macro_probe) $@",
    target_compatible_with = ["@platforms//os:osx"],
    tools = [":exec_proc_macro_probe"],
)

py_test(
    name = "exec_proc_macro_macho_test",
    srcs = ["exec_proc_macro_macho_test.py"],
    data = [":exec_proc_macro_probe_dylib"],
    env = {"EXEC_PROC_MACRO_DYLIB": "$(rootpath :exec_proc_macro_probe_dylib)"},
    main = "exec_proc_macro_macho_test.py",
    python_version = "PY3",
    target_compatible_with = ["@platforms//os:osx"],
)

sh_test(
    name = "zig_macos_toolchain_test",
    srcs = ["zig_macos_toolchain_test.sh"],
    args = ["$(ZIG_BIN)"],
    data = ["@rules_zig//zig:resolved_toolchain"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:osx",
    ],
    toolchains = ["@rules_zig//zig:resolved_toolchain"],
)

exports_files([
    "build_macos_dmg.py",
    "build_macos_notarized_dmg.py",
    "build_macos_signed_app.py",
    "build_macos_signed_file.py",
    "defs.bzl",
    "ghostty-simdutf-include.patch",
    "libghostty-vt-sys-zig-env.patch",
    "linux_cc_toolchain_config.bzl",
    "linux_toolchain_canary.c",
    "zig_macos_toolchain_test.sh",
    "make_tauri_manifest.py",
    "macos_deployment_target.py",
    "normalize_tauri_context.py",
    "openssl-src-bazel-runfiles.patch",
    "tauri-utils-bazel-debug-assertions.patch",
    "tauri-utils-bazel-permission-paths.patch",
])

config_setting(
    name = "linux_arm64_target",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
)

config_setting(
    name = "linux_x86_64_target",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)
