#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" != /* ]]; then
    SOURCE="$SOURCE_DIR/$TARGET"
  else
    SOURCE="$TARGET"
  fi
done

BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/../../.." && pwd)"
KD_DIR="$ROOT_DIR/tools/kd"
RESOLVER="$KD_DIR/bin/kd-resolver.mjs"
LAUNCHER="$KD_DIR/bin/kd-launcher.mjs"

DIST_ENTRY_FILE="$(mktemp "${TMPDIR:-/tmp}/kanna-kd-entry.XXXXXX")"
cleanup() {
  rm -f "$DIST_ENTRY_FILE"
}
trap cleanup EXIT HUP INT TERM

if node "$LAUNCHER" "$RESOLVER" kd >"$DIST_ENTRY_FILE"; then
  :
else
  RESOLVER_STATUS=$?
  exit "$RESOLVER_STATUS"
fi
IFS= read -r DIST_ENTRY <"$DIST_ENTRY_FILE" || true
if [[ -z "$DIST_ENTRY" ]]; then
  echo "kd resolver returned an empty entrypoint" >&2
  exit 1
fi

cleanup
trap - EXIT HUP INT TERM
# kd loads `node:sqlite`, which every Node that ships it still labels
# experimental, so a bare `node` prints an ExperimentalWarning on stderr at
# each launch. kd-mcp serves MCP over stdio and its stderr is a diagnostics
# channel that must stay clean; suppress that one warning class here, at the
# process boundary, rather than every warning.
exec node --disable-warning=ExperimentalWarning "$DIST_ENTRY" "$@"
