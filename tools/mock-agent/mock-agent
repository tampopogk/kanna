#!/usr/bin/env python3
import atexit
import base64
import hashlib
import json
import os
import re
import select
import signal
import socket
import struct
import subprocess
import sys
import termios
import threading
import time
import tty
import uuid

VERSION = "mock-agent 1.0.0"
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
lock = threading.Lock()


def out(text):
    with lock:
        sys.stdout.write(text)
        sys.stdout.flush()


def composer():
    out("\r\n› \r\n  ? for shortcuts\x1b[1A\x1b[3G")


def work(seconds):
    out("\x1b]9;4;3\x07")
    start = time.monotonic()
    frame = 0
    while time.monotonic() - start < seconds:
        elapsed = int(time.monotonic() - start)
        out(f"\x1b[?2026h\r\x1b[2K{SPINNER[frame % len(SPINNER)]} Working ({elapsed}s • esc to interrupt)\x1b[?2026l")
        frame += 1
        time.sleep(0.1)
    out("\r\x1b[2K\x1b]9;4;0\x07")


CHOICES = ["Yes", "No"]
PROGRAM = os.path.basename(sys.argv[0])
QUESTION = "Would you like to run the following command?" if PROGRAM == "codex" else "Do you want to proceed?"


def draw(choice):
    for i, name in enumerate(CHOICES):
        out(f"\r\x1b[2K{'❯' if i == choice else ' '} {i + 1}. {name}\r\n")


def ask():
    out(f"\r\n{QUESTION}\r\n")
    choice = 0
    draw(choice)
    fd = sys.stdin.fileno()
    if not os.isatty(fd):
        line = sys.stdin.readline().split()
        return 0 if line[:1] in (["1"], ["y"], ["yes"]) else 1
    saved = termios.tcgetattr(fd)
    tty.setraw(fd)
    out("\x1b[?1h")
    try:
        while True:
            data = os.read(fd, 64)
            if not data:
                return 1
            while data:
                if data.startswith((b"\x1bOA", b"\x1bOB")):
                    choice = max(0, min(len(CHOICES) - 1, choice + (1 if data[2:3] == b"B" else -1)))
                    out(f"\x1b[{len(CHOICES)}A")
                    draw(choice)
                    data = data[3:]
                elif data.startswith((b"\x1b[A", b"\x1b[B")):
                    out(f"key: {data[:3]!r} (not in application cursor mode)\r\n")
                    data = data[3:]
                elif data[:1] in (b"\r", b"\n"):
                    return choice
                elif data[:1] in (b"1", b"2", b"y"):
                    picked = 0 if data[:1] in (b"1", b"y") else 1
                    if data[1:2] not in (b"\r", b"\n") and select.select([fd], [], [], 0.2)[0]:
                        os.read(fd, 1)
                    return picked
                elif data[:1] in (b"\x1b", b"\x03"):
                    return 1
                else:
                    data = data[1:]
    finally:
        out("\x1b[?1l")
        termios.tcsetattr(fd, termios.TCSANOW, saved)


def session(args):
    for flag, resumed in (("resume", True), ("--resume", True), ("--session-id", False)):
        if flag in args[:-1]:
            return args[args.index(flag) + 1], resumed
    return str(uuid.uuid4()), False


def first(args):
    told = [a for a in args if "Your task: " in a]
    return told[-1].split("Your task: ", 1)[1] if told else None


def inbox():
    home = os.environ.get("KANNA_AGENTS_HOME")
    if PROGRAM != "claude" or not home:
        return
    path = f"/tmp/kanna-mock-{os.getpid()}.sock"
    entry = os.path.join(home, ".claude", "sessions", f"{os.getpid()}.json")
    os.makedirs(os.path.dirname(entry), exist_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    server.listen()
    with open(entry, "w") as f:
        json.dump({"pid": os.getpid(), "peerProtocol": 1, "messagingSocketPath": path}, f)
    atexit.register(lambda: [os.remove(p) for p in (path, entry) if os.path.exists(p)])

    def serve():
        while True:
            conn, _ = server.accept()
            for line in conn.makefile():
                message = json.loads(line)
                if message.get("type") == "user":
                    inbound(message["message"]["content"])
            conn.close()

    threading.Thread(target=serve, daemon=True).start()


def inbound(text):
    envelope = re.fullmatch(r'<cross-session-message(?: from-mode="(bypass|prompting)")?>\n([\s\S]*)\n</cross-session-message>', text)
    stated = envelope and envelope.group(1)
    mine = "bypass" if "--dangerously-skip-permissions" in sys.argv else "prompting"
    if stated != mine and (stated or mine == "bypass"):
        out("\x1b[J\r\nheld peer message: the sender did not attest its permission mode\r\n")
        return composer()
    peer(re.sub(r"<\\(?=/cross-session-message)", "<", envelope.group(2)) if envelope else text)


def peer(text):
    out("\x1b[J\r\n" + "\r\n".join(f"peer: {l}" for l in text.splitlines()) + "\r\n")
    work(1)
    composer()


def remote(args):
    if "--remote" not in args:
        return
    turns = args[args.index("--remote") + 1].removeprefix("unix://") + ".turns"

    def follow():
        seen = 0
        while True:
            lines = open(turns).read().splitlines() if os.path.exists(turns) else []
            for line in lines[seen:]:
                peer(json.loads(line))
            seen = len(lines)
            time.sleep(0.1)

    threading.Thread(target=follow, daemon=True).start()


def app_server(args):
    path = args[args.index("--listen") + 1].removeprefix("unix://")
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    server.listen()
    atexit.register(lambda: [os.remove(p) for p in (path, path + ".turns") if os.path.exists(p)])
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    while True:
        conn, _ = server.accept()
        threading.Thread(target=rpc, args=(conn, path + ".turns"), daemon=True).start()


def rpc(conn, turns):
    head = b""
    while b"\r\n\r\n" not in head:
        head += conn.recv(1)
    key = [l.split(b":", 1)[1].strip() for l in head.split(b"\r\n") if l.lower().startswith(b"sec-websocket-key:")][0]
    accept = base64.b64encode(hashlib.sha1(key + b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11").digest())
    conn.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + b"\r\n\r\n")
    stream = conn.makefile("rb")
    while True:
        head = stream.read(2)
        if len(head) < 2 or head[0] & 0x0F == 8:
            return
        size = head[1] & 0x7F
        if size == 126:
            size = struct.unpack(">H", stream.read(2))[0]
        elif size == 127:
            size = struct.unpack(">Q", stream.read(8))[0]
        mask = stream.read(4) if head[1] & 0x80 else b"\0\0\0\0"
        call = json.loads(bytes(b ^ mask[i % 4] for i, b in enumerate(stream.read(size))))
        method = call.get("method")
        if "id" not in call:
            continue
        if method == "thread/loaded/list":
            result = {"data": ["mock-title", "mock-session"]}
        elif method == "thread/read":
            id = call["params"]["threadId"]
            result = {"thread": {"id": id, "ephemeral": id == "mock-title"}}
        elif method == "turn/start":
            with open(turns, "a") as f:
                f.write(json.dumps(call["params"]["input"][0]["text"]) + "\n")
            result = {"turn": {"id": "mock-turn"}}
        else:
            result = {}
        data = json.dumps({"jsonrpc": "2.0", "id": call["id"], "result": result}).encode()
        frame = bytes([0x81]) + (bytes([len(data)]) if len(data) < 126 else bytes([126]) + struct.pack(">H", len(data)))
        conn.sendall(frame + data)


def bye(id):
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    if PROGRAM == "claude":
        out(f"\r\nResume this session with:\r\nclaude --resume {id}\r\n")
    else:
        out(f"\r\nTo continue this session, run: {PROGRAM} resume {id}\r\n")


def main():
    if "--version" in sys.argv[1:]:
        print(VERSION)
        return 0
    if sys.argv[1:2] == ["app-server"]:
        return app_server(sys.argv[1:])
    if os.isatty(sys.stdin.fileno()):
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        tty.setraw(fd, termios.TCSANOW)
        atexit.register(lambda: termios.tcsetattr(fd, termios.TCSANOW, saved))
    id, resumed = session(sys.argv[1:])
    out("\x1b]0;mock-agent\x07mock-agent: type turn, work N, run COMMAND, ask, report STATUS or exit\r\n")
    if sys.argv[1:]:
        out("args: " + " ".join(sys.argv[1:]) + "\r\n")
    out(f"{'resumed' if resumed else 'session'} {id}\r\n")
    inbox()
    remote(sys.argv[1:])
    try:
        talk(None if resumed else first(sys.argv[1:]))
    except KeyboardInterrupt:
        pass
    bye(id)
    return 0


def talk(task):
    composer()
    if task and not answer(task):
        return
    for line in typed():
        if not answer(line):
            return


def typed():
    fd = sys.stdin.fileno()
    if not os.isatty(fd):
        yield from sys.stdin
        return
    line = ""
    while True:
        data = os.read(fd, 1024)
        if not data:
            return
        for c in data.decode("utf8", "replace"):
            if c == "\x03":
                raise KeyboardInterrupt
            if c == "\x04" and not line:
                return
            if c in "\r\n":
                out("\r\n")
                yield line + "\n"
                line = ""
            elif c in "\x7f\x08":
                if line:
                    line = line[:-1]
                    out("\b \b")
            elif c == "\x15":
                out("\b \b" * len(line))
                line = ""
            elif c == "\x17":
                kept = line.rstrip()
                kept = kept[: len(kept) - len(kept.split()[-1])] if kept.split() else ""
                out("\b \b" * (len(line) - len(kept)))
                line = kept
            elif c >= " ":
                line += c
                out(c)


def answer(line):
    words = line.split()
    out("\x1b[J\r\n")
    if words[:1] == ["exit"]:
        return False
    if words[:1] == ["work"]:
        work(float(words[1]) if len(words) > 1 else 2)
        out("WORK_DONE\r\n")
    elif words[:1] == ["run"] and len(words) > 1:
        out("\x1b]9;4;3\x07")
        command = line.strip().split(None, 1)[1]
        ran = subprocess.run(command, shell=True, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        out(f"• Ran {command}\r\n")
        for text in (ran.stdout + ran.stderr).splitlines():
            out(f"  {text}\r\n")
        work(1)
        out(f"RUN_DONE {ran.returncode}\r\n")
    elif words[:1] in (["turn"], ["ask"]):
        if words[:1] == ["turn"]:
            work(2)
        choice = ask()
        out("\x1b[2J\x1b[H")
        if choice == 0:
            work(1)
            out("TURN_DONE\r\n")
        else:
            out("Declined.\r\n")
    elif words[:1] == ["report"]:
        out(f"\x1b]7501;{words[1] if len(words) > 1 else ''}\x1b\\")
        out(f"reported: {words[1] if len(words) > 1 else ''}\r\n")
    else:
        out(f"echo: {line.strip()}\r\n")
    composer()
    return True


if __name__ == "__main__":
    sys.exit(main())
