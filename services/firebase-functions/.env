# Public Firebase Functions parameters shared by production and local defaults.
KANNA_PORTAL_BASE_URL=https://kanna-build-account.web.app
# Unconfigured until an operator selects hosted Portal features per environment.
# The empty value keeps local emulators non-interactive; the callable fails closed.
STRIPE_PORTAL_CONFIGURATION_ID=
# Unconfigured until an operator binds the Kanna Cloud product id per environment
# (the shared Stripe account also bills Kanji Kongbu). Empty fails closed.
STRIPE_PRODUCT_ID=

# Apple selectors are production-only: `.env.kanna-build` overrides these four
# for the kanna-build project. The shared blanks keep staging and clean local
# emulators fail-closed until an operator scopes Apple setup per environment.
APP_STORE_APP_ID=
APP_STORE_GROUP_ID=
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
