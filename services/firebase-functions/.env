# Public Firebase Functions parameters shared by production and local defaults.
KANNA_PORTAL_BASE_URL=https://kanna-build-account.web.app
# Unconfigured until an operator selects hosted Portal features per environment.
# The empty value keeps local emulators non-interactive; the callable fails closed.
STRIPE_PORTAL_CONFIGURATION_ID=

# Apple admission remains unavailable until scoped ASC setup is complete.
APP_STORE_APP_ID=
APP_STORE_GROUP_ID=
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
