module(
    name = "kanna_local",
    version = "0.0.0",
)

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

bazel_dep(name = "rules_tauri", version = "0.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "rules_zig", version = "0.12.3")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "aspect_rules_js", version = "3.2.3")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

git_override(
    module_name = "rules_tauri",
    commit = "38064855850d88c1d7c579a58ffe6b9f95658461",
    patch_strip = 1,
    patches = ["//tools/bazel:rules-tauri-linux-context.patch"],
    remote = "https://github.com/jemdiggity/rules_tauri.git",
)

git_repository(
    name = "kanna_ghostty_src",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

exports_files([
    "build.zig",
    "build.zig.zon",
])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
)
""",
    commit = "1f61d9644f42eb1949cf955d61b9bcec41ae22ce",
    patch_args = ["-p1"],
    patches = ["//tools/bazel:ghostty-simdutf-include.patch"],
    remote = "https://github.com/jemdiggity/ghostty.git",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.93.1"],
)
use_repo(
    rust,
    "rust_macos_aarch64__x86_64-apple-darwin__stable_tools",
    "rust_toolchains",
)

register_toolchains("@rust_toolchains//:all")

rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host_tools.host_tools(
    name = "kanna_rust_host_tools",
    version = "1.93.1",
)
use_repo(rust_host_tools, "kanna_rust_host_tools")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "kanna_cli_crates",
    cargo_lockfile = "//crates/kanna-cli:Cargo.lock",
    manifests = ["//:Cargo.cli.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "kanna_mcp_crates",
    cargo_lockfile = "//crates/kanna-mcp:Cargo.lock",
    manifests = ["//:Cargo.mcp.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "daemon_crates",
    cargo_lockfile = "//crates/daemon:Cargo.lock",
    manifests = ["//:Cargo.daemon.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "kanna_server_crates",
    cargo_lockfile = "//crates/kanna-server:Cargo.lock",
    manifests = ["//:Cargo.server.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "task_transfer_crates",
    cargo_lockfile = "//crates/task-transfer:Cargo.lock",
    manifests = ["//:Cargo.task-transfer.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "terminal_recovery_crates",
    cargo_lockfile = "//packages/terminal-recovery:Cargo.lock",
    manifests = ["//:Cargo.terminal-recovery.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "desktop_crates",
    cargo_lockfile = "//:Cargo.desktop.lock",
    manifests = ["//:Cargo.desktop.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "delta_updater_crates",
    cargo_lockfile = "//:Cargo.delta-updater.lock",
    manifests = ["//:Cargo.delta-updater.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    build_script_env = {
        "GHOSTTY_SOURCE_DIR": "$${pwd}/external/+git_repository+kanna_ghostty_src",
        "ZIG": "$${pwd}/$(ZIG_BIN)",
    },
    build_script_toolchains = ["@rules_zig//zig:resolved_toolchain"],
    crate = "libghostty-vt-sys",
    gen_build_script = "on",
    patch_args = ["-p1"],
    patches = [
        "//tools/bazel:libghostty-vt-sys-zig-env.patch",
        "//tools/bazel:libghostty-vt-sys-zig-linux-static.patch",
    ],
    repositories = [
        "daemon_crates",
        "kanna_server_crates",
        "task_transfer_crates",
        "terminal_recovery_crates",
    ],
    build_script_data = [
        "@@+git_repository+kanna_ghostty_src//:build.zig",
        "@@+git_repository+kanna_ghostty_src//:build.zig.zon",
        "@@+git_repository+kanna_ghostty_src//:srcs",
    ],
)

linux_native_repositories = [
    "delta_updater_crates",
    "desktop_crates",
]
linux_native_crates = [
    "atk-sys",
    "cairo-sys-rs",
    "gdk-pixbuf-sys",
    "gdk-sys",
    "gdkx11-sys",
    "gio-sys",
    "glib-sys",
    "gobject-sys",
    "gtk",
    "gtk-sys",
    "javascriptcore-rs-sys",
    "pango-sys",
    "soup3-sys",
    "webkit2gtk-sys",
    "x11",
    "x11-dl",
]

# These build scripts discover the Linux GUI dependency closure through
# pkg-config. Their executable is built for the execution platform; only the
# selected target sysroot is exposed as data and search input.
[
    crate.annotation_select(
        build_script_data = [
            "@@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_arm64//:files",
            "@@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_arm64//:sysroot/.kanna-sysroot",
        ],
        build_script_env = {
            "PATH": "",
            "PKG_CONFIG": "$(execpath @@//packaging/linux:pkg_config)",
            "PKG_CONFIG_ALLOW_CROSS": "1",
            "PKG_CONFIG_LIBDIR": "$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_arm64//:sysroot/.kanna-sysroot)/../usr/lib/aarch64-linux-gnu/pkgconfig:$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_arm64//:sysroot/.kanna-sysroot)/../usr/lib/pkgconfig:$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_arm64//:sysroot/.kanna-sysroot)/../usr/share/pkgconfig",
            "PKG_CONFIG_PATH": "",
            "PKG_CONFIG_SYSROOT_DIR": "$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_arm64//:sysroot/.kanna-sysroot)/..",
        },
        build_script_tools = ["@@//packaging/linux:pkg_config"],
        crate = native_crate,
        repositories = linux_native_repositories,
        triples = ["aarch64-unknown-linux-gnu"],
    )
    for native_crate in linux_native_crates
]
[
    crate.annotation_select(
        build_script_data = [
            "@@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_amd64//:files",
            "@@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_amd64//:sysroot/.kanna-sysroot",
        ],
        build_script_env = {
            "PATH": "",
            "PKG_CONFIG": "$(execpath @@//packaging/linux:pkg_config)",
            "PKG_CONFIG_ALLOW_CROSS": "1",
            "PKG_CONFIG_LIBDIR": "$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_amd64//:sysroot/.kanna-sysroot)/../usr/lib/x86_64-linux-gnu/pkgconfig:$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_amd64//:sysroot/.kanna-sysroot)/../usr/lib/pkgconfig:$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_amd64//:sysroot/.kanna-sysroot)/../usr/share/pkgconfig",
            "PKG_CONFIG_PATH": "",
            "PKG_CONFIG_SYSROOT_DIR": "$(execpath @@+ubuntu_sysroot_repository+ubuntu_noble_sysroot_amd64//:sysroot/.kanna-sysroot)/..",
        },
        build_script_tools = ["@@//packaging/linux:pkg_config"],
        crate = native_crate,
        repositories = linux_native_repositories,
        triples = ["x86_64-unknown-linux-gnu"],
    )
    for native_crate in linux_native_crates
]
crate.annotation(
    crate = "openssl-src",
    data_glob = ["openssl/**"],
    patch_args = ["-p1"],
    patches = [
        "//tools/bazel:openssl-src-bazel-runfiles.patch",
        "//tools/bazel:openssl-src-zig-ranlib.patch",
    ],
    repositories = [
        "desktop_crates",
        "kanna_cli_crates",
        "kanna_mcp_crates",
        "kanna_server_crates",
    ],
)
crate.annotation(
    crate = "tauri-utils",
    patch_args = ["-p1"],
    patches = [
        "//tools/bazel:tauri-utils-bazel-permission-paths.patch",
        "//tools/bazel:tauri-utils-bazel-debug-assertions.patch",
    ],
    repositories = ["desktop_crates"],
)
use_repo(crate, "kanna_cli_crates")
use_repo(
    crate,
    "daemon_crates",
    "delta_updater_crates",
    "desktop_crates",
    "desktop_crates__tauri-2.10.3",
    "desktop_crates__tauri-plugin-dialog-2.7.0",
    "desktop_crates__tauri-plugin-opener-2.5.3",
    "desktop_crates__tauri-plugin-process-2.3.1",
    "desktop_crates__tauri-plugin-shell-2.3.5",
    "desktop_crates__tauri-plugin-updater-2.10.1",
    "desktop_crates__tauri-plugin-webdriver-0.2.1",
    "kanna_mcp_crates",
    "kanna_server_crates",
    "task_transfer_crates",
    "terminal_recovery_crates",
)

zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")

# rules_zig 0.12.3 predates Zig 0.16.0; this index adds its official archives.
zig.index(file = "//tools/bazel:zig-versions.json")
zig.mirrors(
    urls = ["https://zig.chainsafe.dev"],
)
zig.toolchain(
    default = True,
    zig_version = "0.16.0",
)
use_repo(
    zig,
    "zig_0.16.0_aarch64-linux",
    "zig_0.16.0_aarch64-macos",
    "zig_0.16.0_x86_64-linux",
    "zig_toolchains",
)

ubuntu_sysroot_repository = use_repo_rule(
    "//packaging/linux:sysroot_repository.bzl",
    "ubuntu_sysroot_repository",
)
ubuntu_sysroot_repository(
    name = "ubuntu_noble_sysroot_amd64",
    architecture = "amd64",
    lock = "//packaging/linux:sysroot-amd64.lock.json",
)
ubuntu_sysroot_repository(
    name = "ubuntu_noble_sysroot_arm64",
    architecture = "arm64",
    lock = "//packaging/linux:sysroot-arm64.lock.json",
)

register_toolchains(
    "//:linux_arm64_cc_on_linux_arm64",
    "//:linux_arm64_cc_on_linux_x86_64",
    "//:linux_arm64_cc_on_macos_arm64",
    "//tools/bazel:linux_arm64_zig_target_toolchain",
    "//:linux_x86_64_cc_on_linux_arm64",
    "//:linux_x86_64_cc_on_linux_x86_64",
    "//:linux_x86_64_cc_on_macos_arm64",
    "//tools/bazel:linux_x86_64_zig_target_toolchain",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

pnpm.pnpm(pnpm_version = "10.29.3")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "kanna_npm",
    data = ["//:pnpm-workspace.yaml"],
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "kanna_npm")
