load("@kanna_server_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_srcs",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
    ] + glob(["src/**/*.rs", "resources/**/*.json", "resources/copilot-wake/*.mjs"]),
)

rust_binary(
    name = "kanna_server",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "kanna_server",
    compile_data = [
        "resources/agent-catalog.json",
        "resources/copilot-wake/bridge.mjs",
        "resources/copilot-wake/extension.mjs",
        "//:VERSION",
        "//:kanna_builtin_resources",
        "//packages/core:src/workflow/kanna-task-environment.md",
    ],
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        "//crates/daemon:kanna_daemon_lib_for_server",
        "//crates/kanna-agent-protocol:kanna_agent_protocol_for_server",
        "//crates/kanna-secure-channel:kanna_secure_channel_for_server",
        "//crates/kanna-tool-catalog:kanna_tool_catalog_for_server",
        "//crates/runtime-defaults:kanna_runtime_defaults",
        "//crates/visual-companion:kanna_visual_companion_for_server",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "kanna_server_x86_64",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "kanna_server",
    compile_data = [
        "resources/agent-catalog.json",
        "resources/copilot-wake/bridge.mjs",
        "resources/copilot-wake/extension.mjs",
        "//:VERSION",
        "//:kanna_builtin_resources",
        "//packages/core:src/workflow/kanna-task-environment.md",
    ],
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        "//crates/daemon:kanna_daemon_lib_for_server",
        "//crates/kanna-agent-protocol:kanna_agent_protocol_for_server",
        "//crates/kanna-secure-channel:kanna_secure_channel_for_server",
        "//crates/kanna-tool-catalog:kanna_tool_catalog_for_server",
        "//crates/runtime-defaults:kanna_runtime_defaults",
        "//crates/visual-companion:kanna_visual_companion_for_server",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    platform = "//tools/bazel:macos_x86_64",
)
