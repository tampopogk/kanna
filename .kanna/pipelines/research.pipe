# Research and design only: a spec and a mockup, approved by you, then landed. No build.
budget  = 10 sessions, 6h

research = claude:high prompt research          # docs/research/X.md with sources
spec     = claude:high prompt spec
approve  = ask "Spec and mockup right?"
land     = merge main

research -> spec -> approve
approve -[fail, max 4]-> spec
approve -> land -> done
